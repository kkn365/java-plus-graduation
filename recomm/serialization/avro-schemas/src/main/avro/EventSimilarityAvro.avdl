@namespace("ru.practicum.recommendations.avro")
protocol EventSimilarityProtocol {

	/**
	 * Запись, представляющая пару похожих мероприятий и их уровень сходства.
	 *
	 * Используется для хранения результатов анализа сходства между мероприятиями.
	 */
	record EventSimilarityAvro {
		/**
		 * Идентификатор первого мероприятия в паре.
		 *
		 * Представляет собой исходное мероприятие.
		 */
		long source_event_id;

		/**
		 * Идентификатор второго мероприятия в паре.
		 *
		 * Представляет собой мероприятие, похожее на первое.
		 */
		long target_event_id;

		/**
		 * Числовой показатель сходства между двумя мероприятиями.
		 *
		 * Значение находится в диапазоне [0, 1], где:
		 * - 0 означает полное отсутствие сходства,
		 * - 1 означает полное совпадение.
		 */
		double similarity_score;

		/**
		 * Временная метка, указывающая, когда была рассчитана схожесть.
		 *
		 * Хранится в миллисекундах с эпохи Unix.
		 */
		timestamp_ms calculated_at;
	}
}